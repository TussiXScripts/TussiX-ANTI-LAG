local function removeAnimationsFromHumanoid(humanoid)

	if humanoid then

		-- Detener animaciones
		for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
			track:Stop()
		end

		-- Quitar animator
		local animator = humanoid:FindFirstChildOfClass("Animator")

		if animator then
			animator:Destroy()
		end

	end

